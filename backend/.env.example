# API Configuration
API_TITLE=MarketAtlas
API_VERSION=1.0.0
API_DEBUG=False
JWT_SECRET=replace-with-a-long-random-secret

# Database Configuration
DB_DRIVER=postgresql+asyncpg
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marketatlas
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=False

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Market Agents Service (external microservice from separate repo)
MARKET_AGENTS_URL=http://localhost:8004

# Knowledge Graph Agent Service (external microservice)
KG_AGENT_URL=http://localhost:8008

# Graph Engine Service (external microservice; owns port 8005)
GRAPH_ENGINE_URL=http://localhost:8005

# World State Service (external microservice)
WORLD_STATE_URL=http://localhost:8006
WORLD_STATE_API_KEY=replace-with-a-separate-long-random-service-key

# Memory Service (external microservice)
MEMORY_URL=http://localhost:8010

# Simulator Service (external microservice)
SIMULATOR_URL=http://localhost:8007

# Sector Market Data Feed (predefined sector -> ticker map; TTL in seconds)
SECTOR_TICKERS=technology:AAPL,MSFT,NVDA;semiconductors:AMD,INTC,AVGO;energy:XOM,CVX,COP;defense:LMT,RTX,NOC;financials:JPM,BAC,GS;healthcare:JNJ,UNH,LLY;consumer_cyclical:AMZN,TSLA,HD;consumer_defensive:PG,KO,WMT;utilities:NEE,DUK,SO;materials:LIN,SHW,FCX;commodities:GLD,SLV,USO
SECTOR_CACHE_TTL_SECONDS=1800

# Feature Flags
ENABLE_WORKERS=True

# AI / LLM keys (Perplexity recommended for live web answers with citations)
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar-pro
GEMINI_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=
